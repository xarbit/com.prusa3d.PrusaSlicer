diff --git a/src/slic3r-app-desktop/src/Slic3r/App/Desktop/DesktopApp.cpp b/src/slic3r-app-desktop/src/Slic3r/App/Desktop/DesktopApp.cpp
index 26615bab6c..775d9f3cc7 100644
--- a/src/slic3r-app-desktop/src/Slic3r/App/Desktop/DesktopApp.cpp
+++ b/src/slic3r-app-desktop/src/Slic3r/App/Desktop/DesktopApp.cpp
@@ -257,7 +257,15 @@ bool DesktopApp::OnInit()
     bool is_editor     = true; // is_editor();
     const std::string last_crash_reason =
         app_services.app_config().get<std::string>("crash_reason");
-    if (app_services.app_config().get<bool>("show_splash_screen")) {
+    // The splash screen is a top level window that positions itself over the
+    // main window and asks to stay on top. Neither is possible under Wayland:
+    // a client cannot place its own windows and there is no way to request a
+    // stacking order, so the compositor places it wherever it likes, usually
+    // behind the main window, where it is useless at best and a stray window
+    // at worst. The canvas renders its own loading screen anyway, so skip it.
+    const bool splash_usable = ::getenv("WAYLAND_DISPLAY") == nullptr;
+
+    if (splash_usable && app_services.app_config().get<bool>("show_splash_screen")) {
         // Detect position (display) to show the splash screen
         // Now this position is equal to the mainframe position
         wxPoint splashscreen_pos = wxDefaultPosition;
