+    // A single centred line, so the window says what it is doing instead of
+    // showing an empty background while the presets are being loaded.
+    Yoga::Item* status_box = m_layout.emplace_back<Yoga::Item>();
+    status_box->set_width_percent(100.f);
+    status_box->set_height_percent(100.f);
+    status_box->set_orientation(Yoga::Orientation::Vertical);
+    status_box->set_justify_content(YGJustifyCenter);
+    status_box->set_align_items(YGAlignCenter);
+    status_box->set_gap(16.f);
+
+    // The application icon, so the loading screen is recognisably PrusaSlicer
+    // rather than an empty window. Loaded as SVG so it stays sharp at any
+    // scale factor.
+    Yoga::Icon* logo = status_box->emplace_back<Yoga::Icon>(Render::Icon::None, 128);
+    logo->set_image("icons/PrusaSlicer.svg");
+
+    m_status_text = status_box->emplace_back<Yoga::Text>(m_status);
+
     m_dialog.reset(std::make_unique<PresetUpdaterDialog>(m_controller, m_navigator));
     m_layout.append(m_dialog.release());
     m_dialog->attach_to_center();
 }
 
+void LoadingRenderModule::set_status(const std::string& status)
+{
+    m_status = status;
+    if (m_status_text != nullptr) {
+        m_status_text->set_text(m_status);
+    }
+}
